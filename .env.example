# Copy this file to .env and set your Groq API key there.
# Keep the real key out of Git and chat.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional: full path to the Tesseract executable on Windows.
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
